---
import { getCollection } from "astro:content";

import Layout from "$/components/Layout.astro";
import List from "$/components/List.astro";
import ListItem from "$/components/ListItem.astro";
import PageTitle from "$/components/PageTitle.astro";

import { formatDate, sortPostsByDate } from "$/lib/date";

const posts = sortPostsByDate(await getCollection("blog"));
---

<Layout
  seo={{
    title: "Blog",
  }}
>
  <PageTitle title="Blog" class="mb-4" />

  <List spacing="relaxed">
    {
      posts.map(({ data: { title, date }, id }) => (
        <ListItem>
          <a class="group w-fit space-y-0.5" href={`/blog/${id}`}>
            <p class="font-medium text-subtitle">
              {/* The &nbsp; makes it so that the arrow is always accompanied by a word when going to the next line so it's never on its own line */}
              {/* prettier-ignore */}
              <><><span class="decoration-underline underline-offset-4 group-hover:underline group-focus:underline group-active:underline">{title}</span><span class="text-caption select-none" aria-hidden="true">&nbsp;→</span></></>
            </p>

            <p class="text-caption">{formatDate(date)}</p>
          </a>
        </ListItem>
      ))
    }
  </List>
</Layout>
