---
interface Props {
  isNested?: boolean;
  spacing?: "default" | "relaxed";
}

const { isNested, spacing = "default" } = Astro.props;
---

<ul
  class:list={[
    "ml-4 list-outside list-disc sm:ml-5",
    isNested && "mt-2",
    spacing === "relaxed" ? "space-y-6" : "space-y-4 sm:space-y-2",
  ]}
>
  <slot />
</ul>
