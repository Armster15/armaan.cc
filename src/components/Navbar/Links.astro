---
const pathname = Astro.url.pathname;
---

<div
  class:list={[
    "flex items-center justify-start lowercase *:pr-3 max-sm:text-sm sm:justify-center *:sm:px-3",
    "*:text-subtitle-light *:duration-200 *:hover:text-subtitle *:focus:text-subtitle *:active:text-subtitle *:data-[is-current-page='true']:text-subtitle",
  ]}
>
  <a class="max-2xs:hidden" data-is-current-page={pathname === "/"} href="/">Home</a>
  <a data-is-current-page={pathname.startsWith("/blog")} href="/blog">Blog</a>
  <a data-is-current-page={pathname.startsWith("/work")} href="/work">Work</a>
</div>
